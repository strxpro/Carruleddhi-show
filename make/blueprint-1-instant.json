      "mapper": {
        "variables": [
          {
            "name": "regHtml",
            "value": "<!doctype html>\r\n<html lang=\"it\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<meta name=\"x-apple-disable-message-reformatting\">\r\n<style>\r\n  @media only screen and (max-width:620px){\r\n    .wrap{width:100% !important}\r\n    .pad{padding-left:20px !important;padding-right:20px !important}\r\n    .h1{font-size:28px !important;line-height:1.1 !important}\r\n    .num{font-size:56px !important}\r\n    .stack{display:block !important;width:100% !important}\r\n  }\r\n</style>\r\n</head>\r\n<body style=\"margin:0;padding:0;background:#e9f1ff;\">\r\n<div style=\"display:none;font-size:1px;color:#e9f1ff;max-height:0;overflow:hidden;\">{{1.copy.regPreheader}}</div>\r\n\r\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#e9f1ff;\">\r\n<tr><td align=\"center\" style=\"padding:24px 12px;\">\r\n<table role=\"presentation\" class=\"wrap\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:600px;max-width:600px;background:#ffffff;border-radius:18px;overflow:hidden;font-family:'Segoe UI',Helvetica,Arial,sans-serif;\">\r\n\r\n  <tr><td class=\"pad\" style=\"background:#071a3d;padding:26px 34px;\">\r\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\r\n      <td style=\"font-size:19px;font-weight:800;color:#ffffff;\">CARRULEDDHI <span style=\"color:#ffc928;\">SHOW 2026</span></td>\r\n      <td align=\"right\" style=\"font-size:11px;color:#bcd6ff;letter-spacing:1.6px;text-transform:uppercase;\">{{1.ev.date}}</td>\r\n    </tr></table>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" style=\"padding:34px 34px 8px;\">\r\n    <p style=\"margin:0 0 10px;font-size:15px;color:#5f709a;\">{{1.copy.regHi}}</p>\r\n    <h1 class=\"h1\" style=\"margin:0 0 18px;font-size:32px;line-height:1.08;color:#071a3d;font-weight:800;letter-spacing:-1px;\">{{1.copy.regLead}}</h1>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" style=\"padding:0 34px 26px;\">\r\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#ffc928;border-radius:16px;\">\r\n      <tr><td align=\"center\" style=\"padding:20px 18px;\">\r\n        <div style=\"font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#6a5410;\">{{1.copy.regNumberLabel}}</div>\r\n        <div class=\"num\" style=\"font-size:66px;line-height:1;font-weight:800;color:#071a3d;letter-spacing:-2px;padding-top:4px;\">{{1.raceNumber}}</div>\r\n      </td></tr>\r\n    </table>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" style=\"padding:0 34px 8px;\">\r\n    <div style=\"font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#f6494f;padding-bottom:10px;\">{{1.copy.regWhenTitle}}</div>\r\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border:1px solid #dbe5f5;border-radius:14px;\">\r\n      <tr>\r\n        <td class=\"stack\" width=\"50%\" style=\"padding:14px 18px;font-size:14px;color:#071a3d;border-right:1px solid #dbe5f5;\">\r\n          <strong style=\"display:block;font-size:22px;font-weight:800;\">{{1.ev.date}}</strong>\r\n          <span style=\"color:#5f709a;\">{{1.ev.presentation}} &middot; {{1.ev.start}}</span>\r\n        </td>\r\n        <td class=\"stack\" width=\"50%\" style=\"padding:14px 18px;font-size:14px;color:#5f709a;line-height:1.5;\">{{1.ev.place}}</td>\r\n      </tr>\r\n    </table>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" align=\"center\" style=\"padding:20px 34px 30px;\">\r\n    <a href=\"{{1.ev.map}}\" style=\"display:inline-block;background:#2469d8;color:#ffffff;font-size:14px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;text-decoration:none;padding:14px 26px;border-radius:999px;\">{{1.copy.regCta}} &rarr;</a>\r\n  </td></tr>\r\n\r\n  <!-- Najważniejszy blok w całym mailu. -->\r\n  <tr><td class=\"pad\" style=\"padding:0 34px 26px;\">\r\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#fff3f3;border:2px solid #f6494f;border-radius:14px;\">\r\n      <tr><td style=\"padding:18px 20px;\">\r\n        <div style=\"font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;color:#c22c32;padding-bottom:6px;\">&#9888;&#65039; {{1.copy.regPrintTitle}}</div>\r\n        <div style=\"font-size:14px;line-height:1.6;color:#7a2a2e;\">{{1.copy.regPrintBody}}</div>\r\n      </td></tr>\r\n    </table>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" style=\"padding:0 34px 26px;\">\r\n    <div style=\"font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#f6494f;padding-bottom:8px;\">{{1.copy.regPdfTitle}}</div>\r\n    <div style=\"font-size:14px;line-height:1.65;color:#43516f;\">{{1.copy.regPdfBody}}</div>\r\n  </td></tr>\r\n\r\n  <!-- Tabela danych: dziewięć stałych wierszy zamiast pętli. -->\r\n  <tr><td class=\"pad\" style=\"padding:0 34px 6px;\">\r\n    <div style=\"font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#f6494f;padding-bottom:10px;\">{{1.copy.regDetailsTitle}}</div>\r\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px;color:#071a3d;\">\r\n      <tr><td width=\"42%\" style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.fullName}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{1.fullName}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.birthDate}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{formatDate(1.birthDate; \"DD.MM.YYYY\")}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.postalCode}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{1.postalCode}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.email}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{lower(1.email)}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.phone}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{1.phone}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.address}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{1.address}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.cartName}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{1.cartName}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.category}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{upper(1.category)}}</td></tr>\r\n      <tr><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;color:#5f709a;\">{{1.copy.labels.team}}</td><td style=\"padding:9px 0;border-bottom:1px solid #eef2fa;font-weight:700;\">{{ifempty(1.teamName; \"—\")}}</td></tr>\r\n      \r\n    </table>\r\n    <div style=\"font-size:12px;color:#5f709a;padding-top:12px;\">{{1.copy.regDetailsNote}}</div>\r\n  </td></tr>\r\n\r\n  <!-- Lista kontrolna: join() zamiast pętli. -->\r\n  <tr><td class=\"pad\" style=\"padding:26px 34px 0;\">\r\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f4f8ff;border-radius:14px;\">\r\n      <tr><td style=\"padding:18px 20px;\">\r\n        <div style=\"font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;color:#174ea6;padding-bottom:8px;\">{{1.copy.regChecklistTitle}}</div>\r\n        <ul style=\"margin:0;padding-left:20px;font-size:14px;line-height:1.7;color:#2f3f5e;\">\r\n          <li>{{join(1.copy.regChecklist; \"</li><li>\")}}</li>\r\n        </ul>\r\n      </td></tr>\r\n    </table>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" style=\"padding:26px 34px 30px;\">\r\n    <div style=\"font-size:13px;font-weight:800;color:#071a3d;padding-bottom:4px;\">{{1.copy.regHelpTitle}}</div>\r\n    <div style=\"font-size:14px;color:#43516f;\">{{1.copy.regHelp}}</div>\r\n  </td></tr>\r\n\r\n  <tr><td class=\"pad\" style=\"background:#071a3d;padding:22px 34px;\">\r\n    <div style=\"font-size:12px;line-height:1.6;color:#8fb0e8;\">{{1.copy.footerNote}}</div>\r\n    <div style=\"font-size:12px;color:#8fb0e8;padding-top:8px;\">\r\n      <a href=\"mailto:{{1.ev.email}}\" style=\"color:#ffc928;text-decoration:none;\">{{1.ev.email}}</a>\r\n      &nbsp;&middot;&nbsp;\r\n      <a href=\"https://carruleddhishow.com/regolamento.html?lang={{1.loc}}\" style=\"color:#ffffff;\">Regolamento</a>\r\n      &nbsp;&middot;&nbsp;\r\n      <a href=\"https://carruleddhishow.com/privacy.html?lang={{1.loc}}\" style=\"color:#ffffff;\">Privacy</a>\r\n    </div>\r\n  </td></tr>\r\n\r\n</table>\r\n</td></tr>\r\n</table>\r\n</body>\r\n</html>"
          },
          {
