{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/obs/:scene(starting|intro|break|voting|results|standby|ending)", "destination": "/obs-:scene" },
    { "source": "/obs/effects/:effect(confetti|ribbons|sparkles)", "destination": "/obs-effect-:effect" },
    {
      "source": "/api/broadcast/:action",
      "destination": "/api/intake?broadcastAction=:action"
    },
    {
      "source": "/obs/replay",
      "destination": "/obs-replay"
    },
    {
      "source": "/obs/overlay",
      "destination": "/obs-overlay"
    },
    {
      "source": "/obs/participant",
      "destination": "/obs-participant"
    },
    {
      "source": "/obs/sponsors",
      "destination": "/obs-sponsors"
    },
    {
      "source": "/api/carruleddhi/:type",
      "destination": "/api/intake?type=:type"
    }
  ],
  "headers": [
    {
      "source": "/obs/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
